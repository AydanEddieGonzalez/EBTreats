# Claude API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
# Claude models: main model, then fallbacks if it is busy or rate-limited
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FALLBACK_MODELS=claude-haiku-5-5


# USDA FoodData Central key, used by receipt OCR to check if a line is food (https://fdc.nal.usda.gov/api-key-signup)
USDA_API_KEY=

# MongoDB connection
MONGODB_URI=
MONGODB_DB=

# Optional: only set these if auto-detection fails
# Windows example: C:\Users\you\...\EBTreats\venv\Scripts\python.exe
PYTHON_PATH=
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
