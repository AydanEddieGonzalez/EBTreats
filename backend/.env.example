# Copy this file to backend/.env and fill in your values. Never commit .env.

# Gemini API key, used for recipe generation (https://aistudio.google.com/apikey)
MY_API_KEY=
# Gemini model name; change if Google retires it
GEMINI_MODEL=gemini-3.8-flash

# USDA FoodData Central key, used by receipt OCR to check if a line is food (https://fdc.nal.usda.gov/api-key-signup)
USDA_API_KEY=

# MongoDB connection
MONGODB_URI=
MONGODB_DB=

# Optional: only set these if auto-detection fails
# Windows example: C:\Users\you\...\EBTreats\venv\Scripts\python.exe
PYTHON_PATH=
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
